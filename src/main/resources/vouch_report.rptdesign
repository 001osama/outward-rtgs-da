            <xml-property name="queryText"><![CDATA[select 
R.branch_cd || '-' || R.voucher_no || '/' || R.voucher_year as VoucherNo,
R.posted_date as VoucherDate,
R.status as VoucherStatus,
'WTS:0/0 SBP Outward Vo:' || R.voucher_no || '/' || R.voucher_year as Narration,
POP.purpose_of_payment_type || '-' || POP.purpose_of_payment_cd || ' ' || R.remarks as Remarks,
R.posted_by as PostBy

from rtgs_tl R
JOIN purpose_of_payment_tl as POP
ON R.purpose_of_payment_cd = POP.purpose_of_payment_cd

WHERE R.VOUCHER_NO =? AND R.VOUCHER_YEAR =?]]></xml-property>
