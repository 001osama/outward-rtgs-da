            <xml-property name="queryText"><![CDATA[SELECT 
'OR' AS ORIG_RESP,
CASE 
	WHEN AMOUNT < 0 
	THEN ABS(AMOUNT)
	ELSE null 
	END AS DEBIT,
CASE 
	WHEN AMOUNT > 0 
	THEN AMOUNT 
	ELSE null
	END AS CREDIT, 
CASE 
	WHEN T.ACCOUNT_IDENTITY = 'C' 
	THEN LPAD(AC.branch_cd, 4, '0') || '-' || 
	LPAD(AC.account_type_cd, 4, '0') || '-' ||
	LPAD(AC.customer_no, 6, '0') || '-' || 
	LPAD(AC.run_no, 2, '0') || '-' || AC.check_digit 
ELSE 
	GL.IDENTITY || '-' || LPAD(GL.MAIN_HD, 3, '0') || '-' || 
	LPAD(GL.SUB_HD_1, 2, '0') || '-' || 
	LPAD(GL.SUB_HD_2, 2, '0') || '-' || 
	LPAD(GL.GL_RUN_NO, 4, '0') || '-' || 
	GL.GL_CHECK_DIGIT 
END AS ACCOUNT_NO,

CASE 
	WHEN T.ACCOUNT_IDENTITY = 'G'
	THEN RT.CHEQUE_NO || '/' ||RT.BRANCH_CD
	ELSE NULL
END AS INST_NO,

T.TRAN_CODE,

CASE 
	WHEN RT.STATUS = 'U'
	THEN VARCHAR(T.REFERENCE_NO)
	ELSE VARCHAR(T.TRAN_NO)
END AS TRAN_NO,

CASE 
	WHEN T.ACCOUNT_IDENTITY = 'G'
	THEN RT.CHEQUE_DATE
	ELSE NULL
END AS INST_DATE,

CASE 
	WHEN T.ACCOUNT_IDENTITY = 'C' 
	THEN AC.account_title 
	ELSE GL.account_title 
	END AS ACCOUNT_TITLE, 
'PKR' AS CURRENCY_CODE FROM TRANSACTION_TL AS T
LEFT JOIN ACCOUNT_TL AC ON T.branch_cd = AC.branch_cd 
AND T.account_type_cd = AC.account_type_cd 
AND T.customer_no = AC.customer_no  
AND T.run_no = AC.run_no AND T.check_digit = AC.check_digit 
AND T.ACCOUNT_IDENTITY = 'C'

LEFT JOIN GL_ACCOUNT_TL AS GL ON T.MAIN_HD = GL.MAIN_HD 
AND T.SUB_HD_1 = GL.SUB_HD_1 AND T.SUB_HD_2 = GL.SUB_HD_2 
AND T.GL_RUN_NO = GL.GL_RUN_NO AND T.GL_CHECK_DIGIT = GL.GL_CHECK_DIGIT 
AND T.IDENTITY = GL.IDENTITY AND T.BRANCH_CD = GL.BRANCH_CD 
AND T.ACCOUNT_IDENTITY = 'G'

LEFT JOIN RTGS_TL AS RT ON  
T.VOUCHER_NO = RT.VOUCHER_NO 
AND T.VOUCHER_YEAR = RT.VOUCHER_YEAR

WHERE T.VOUCHER_NO = ? AND T.VOUCHER_YEAR = ?
 
]]></xml-property>
