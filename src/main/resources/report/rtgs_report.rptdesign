            <xml-property name="queryText"><![CDATA[SELECT
    r.branch_cd AS "Brn Cd",
    rb.advise_no || '/' || rb.advise_year AS "Advice No/Year",
    r.transfer_type AS  "Tran Type",
    a.branch_cd || '-' || a.account_type_cd || '-' || a.customer_no || '-' || a.run_no || '-' || a.check_digit || '/' || a.account_title AS "Account Number/Account Name",
    rb.account_no || '/' || rb.account_title AS "Benef AccNo/Name",
    rb.address AS "Beneficiary Address",
    b.bank_name AS "Beneficiary Bank Name",
    r.voucher_no || '/' || r.voucher_year AS "VouchNo/Year",
    rb.amount AS "Tran Amt",
    r.sbp_transaction_type_cd AS "TypeC"
FROM RTGS_TL r
JOIN RTGS_BENEFICIARY_TL rb ON r.voucher_no = rb.voucher_no
JOIN ACCOUNT_TL a ON r.branch_cd = a.branch_cd
JOIN BANKS_TL b ON rb.bank_cd = b.bank_cd]]></xml-property>
