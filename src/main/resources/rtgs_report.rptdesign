            <xml-property name="queryText"><![CDATA[SELECT 
DISTINCT RBT.ADVISE_NO || '/' || RBT.ADVISE_YEAR AS ADVICE_NO,
LPAD(RT.BRANCH_CD, 4, '0') AS BRANCH_CD,
TT.TRANSACTION_DATE, RT.TRANSFER_TYPE, 
		LPAD(AT.BRANCH_CD, 4, '0') || '-' || 
		LPAD(AT.ACCOUNT_TYPE_CD, 4, '0') || '-' || 
		LPAD(AT.CUSTOMER_NO, 6, '0') || '-' || 
		LPAD(AT.RUN_NO, 2, '0') || '-' || 
		AT.CHECK_DIGIT || '-' || AT.ACCOUNT_TITLE AS ACCOUNT_INFO,
		RBT.ADDRESS AS BENEFICIARY_ADDRESS,
		RBT.IS_BENEF_TITLE_FETCH,
		BT.BANK_NAME,
		RT.VOUCHER_NO || '/' || RT.VOUCHER_YEAR AS VOUCHER_NO,
		RT.TOTAL_AMOUNT ,
		STTT.SBP_TRANSACTION_TYPE,
		RBT.ACCOUNT_NO || '/' || RBT.ACCOUNT_TITLE AS BENEF_ACCOUNT_INFO
		
FROM RTGS_BENEFICIARY_TL AS RBT 
LEFT JOIN RTGS_TL AS RT 
ON RBT.VOUCHER_NO = RT.VOUCHER_NO

LEFT JOIN SBP_TRANSACTION_TYPE_TL AS STTT 
ON STTT.SBP_TRANSACTION_TYPE_CD = RT.SBP_TRANSACTION_TYPE_CD 

LEFT JOIN ACCOUNT_TL AS AT 
ON 
AT.BRANCH_CD = RT.BRANCH_CD 
AND AT.ACCOUNT_TYPE_CD = RT.ACCOUNT_TYPE_CD
AND AT.CUSTOMER_NO = RT.CUSTOMER_NO 
AND AT.RUN_NO = RT.RUN_NO 
AND AT.CHECK_DIGIT = RT.CHECK_DIGIT

LEFT JOIN TRANSACTION_TL AS TT 
ON RT.VOUCHER_NO = TT.VOUCHER_NO
LEFT JOIN BANKS_TL AS BT ON RBT.BANK_CD = BT.BANK_CD

]]></xml-property>
